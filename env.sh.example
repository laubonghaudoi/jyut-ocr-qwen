# Machine-local configuration for the jyut-ocr-qwen skill.
# Sourced by the agent before running any bundled runner. Nothing here is
# portable: service names, ports and model paths differ per machine, which is
# exactly why it does not live in the skill.

# --- OCR engine A: PaddleOCR-VL (layout + per-block boxes) ---
export PADDLEOCR_PYTHON="$HOME/.venvs/paddleocr/bin/python"

# --- OCR engine B: HunyuanOCR (independent second draft) ---
export HUNYUAN_MODEL="$HOME/models/hunyuanocr/HunyuanOCR-bf16.gguf"
export HUNYUAN_MMPROJ="$HOME/models/hunyuanocr/mmproj-HunyuanOCR-bf16.gguf"
export HUNYUAN_LLAMA_SERVER="$HOME/llama.cpp/build/bin/llama-server"

# --- GPU handover: the OCR engines cannot share the card with the LLM server ---
export OCR_PHASE_RELEASE_CMD="systemctl --user stop ninfer.service"
export OCR_PHASE_RESTORE_CMD="systemctl --user start ninfer.service"
export OCR_PHASE_HEALTH_URL="http://127.0.0.1:8090/v1/models"
# Time budget for ONE handover call, restore included. Keep it below the agent
# harness's shell time limit (Qwen Code: 600000 ms at most, 120 s by default -
# the call must pass its own timeout). A call that runs out exits 75: run the
# same command again; finished pages are kept. Required whenever the server
# has to be stopped (0 = no budget, only outside an agent harness).
# The restore command must be safe to repeat (systemctl start is): a watchdog
# runs it again if the handover is killed mid-way.
export OCR_PHASE_MAX_SECONDS=540

# --- the reading model used by proofread_pages.py ---
export PROOFREAD_ENDPOINT="http://127.0.0.1:8090/v1/chat/completions"
export PROOFREAD_MODEL="qwen3.8-27b"
export PROOFREAD_EFFORT="xhigh"
# Requests proofread_pages.py keeps on the wire at once, across all pages.
# Set it to the server's --max-concurrency for the batch run: a request the
# server cannot admit waits in its queue and fails after its pending timeout.
# Unset, it defaults to --workers.
# export PROOFREAD_MAX_INFLIGHT=8
